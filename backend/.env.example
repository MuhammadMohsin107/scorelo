NODE_ENV=development
PORT=5000
# PostgreSQL connection string. URL-encode special characters in the password.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/scorelo
# When true (and NODE_ENV is not production), requests are authenticated as a mock user (id: 1)
# instead of requiring real credentials. There is no real auth system yet.
MOCK_AUTH=true
# Secrets for signing JWT access/refresh tokens — generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Shopify Partner app credentials — optional. Until set, /api/shopify/* routes return a clear
# 500 (SHOPIFY_NOT_CONFIGURED) instead of working; the rest of the API is unaffected.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# This backend's own public URL — Shopify calls back here directly (must NOT be the frontend's URL).
BACKEND_URL=http://localhost:5000
# Where to send the browser after a successful connect — the frontend app.
FRONTEND_URL=http://localhost:5173
# 32-byte hex key for encrypting stored Shopify access tokens — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=
