# Copy to .env and fill in. Keep the KEYS here in sync with .env — a key added to one and not
# the other is how a deploy fails on a variable nobody noticed was missing. Values are expected
# to differ: this file documents, .env holds real credentials and is never committed.

NODE_ENV=development
PORT=5000

# MySQL 8 / MariaDB 10.5+ connection string. Note the scheme and port: this project moved from
# PostgreSQL to MySQL, so a leftover postgresql://…:5432 URL fails at the driver, not at login.
# URL-encode special characters in the password ('@' becomes %40, a space becomes %20).
DATABASE_URL=mysql://USER:PASSWORD@127.0.0.1:3306/scorelo

# When true (and NODE_ENV is not production), authenticate() returns before it ever reads the
# Authorization header and treats EVERY request as user id 1 — all protected endpoints become
# open. Real signup/login now work, so this defaults to false; turn it on only for deliberate
# local work where you do not want to hold a token, and never where real accounts exist.
MOCK_AUTH=false

# Secrets for signing JWT access/refresh tokens — generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Generate fresh values per environment; never reuse a development secret in production.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ─── Shopify ──────────────────────────────────────────────────────────────────
# Credentials from your Shopify Partner app (Partner Dashboard → Apps → your app → Client
# credentials). Optional: until all four Shopify-related values below are set, /api/shopify/*
# returns a clear 500 (SHOPIFY_NOT_CONFIGURED) and the Integrations page hides Connect. The rest
# of the API is unaffected.
#
# SECRET is server-side only. It must never appear in a VITE_* variable, in frontend code, or in
# any API response — it is what signs and verifies every OAuth callback and webhook.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# In the Partner Dashboard, add this EXACT allowed redirection URL for the app:
#   ${BACKEND_URL}/api/shopify/callback
# and point the three mandatory GDPR webhooks (customers/data_request, customers/redact,
# shop/redact) at ${BACKEND_URL}/api/shopify/webhooks/{customers-data-request,customers-redact,
# shop-redact}. app/uninstalled is registered automatically at install time.
#
# Both URLs must be reachable by a browser, and must match the environment this .env belongs to —
# staging URLs in a local .env send a local OAuth flow to the deployed site.
# Local:    http://localhost:5000  /  http://localhost:5173
# Deployed: the one public origin for both. The API is reached at /api on that same origin
#           (server.cjs proxies it), so there is no api. subdomain.
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# 32-byte hex key used to encrypt stored Shopify access and refresh tokens (AES-256-GCM).
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this makes every stored token undecryptable — merchants would have to reconnect.
TOKEN_ENCRYPTION_KEY=
