# Copy to .env and fill in. Keep the KEYS here in sync with .env — a key added to one and not
# the other is how a deploy fails on a variable nobody noticed was missing. Values are expected
# to differ: this file documents, .env holds real credentials and is never committed.

NODE_ENV=development
PORT=5000

# MySQL 8 / MariaDB 10.5+ connection string. Note the scheme and port: this project moved from
# PostgreSQL to MySQL, so a leftover postgresql://…:5432 URL fails at the driver, not at login.
# URL-encode special characters in the password ('@' becomes %40, a space becomes %20).
DATABASE_URL=mysql://USER:PASSWORD@127.0.0.1:3306/scorelo

# When true (and NODE_ENV is not production), authenticate() returns before it ever reads the
# Authorization header and treats EVERY request as user id 1 — all 31 protected endpoints become
# open. Real signup/login now work, so this defaults to false; turn it on only for deliberate
# local work where you do not want to hold a token, and never where real accounts exist.
MOCK_AUTH=false

# Secrets for signing JWT access/refresh tokens — generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Generate fresh values per environment; never reuse a development secret in production.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Shopify Partner app credentials — optional. Until set, /api/shopify/* routes return a clear
# 500 (SHOPIFY_NOT_CONFIGURED) instead of working; the rest of the API is unaffected.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Both must be reachable by a browser, and must match the environment this .env belongs to —
# staging URLs in a local .env send a local OAuth flow to the deployed site.
# Local:   http://localhost:5000  /  http://localhost:5173
# Deployed: the one public origin, e.g. https://scorelo-staging.example.com for both. The API is
# reached at /api on that same origin (server.cjs proxies it), so there is no api. subdomain.
BACKEND_URL=https://scorelo-staging.tlxapps.com
FRONTEND_URL=https://scorelo-staging.tlxapps.com

# 32-byte hex key for encrypting stored Shopify access tokens — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=
root@recoverly-ubuntu-24:~# cd ..
root@recoverly-ubuntu-24:/# cd home/
root@recoverly-ubuntu-24:/home# cd scorelo-staging/htdocs/scorelo-staging.tlxapps.com/scorelo/
root@recoverly-ubuntu-24:/home/scorelo-staging/htdocs/scorelo-staging.tlxapps.com/scorelo# cd backend/
root@recoverly-ubuntu-24:/home/scorelo-staging/htdocs/scorelo-staging.tlxapps.com/scorelo/backend# bash deploy.sh

